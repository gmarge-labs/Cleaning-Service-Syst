# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://username:password@your-rds-endpoint.amazonaws.com:5432/sparkleville

# Authentication
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Google Drive Integration
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Frontend URL (Amplify domain)
FRONTEND_URL=https://your-amplify-domain.amplifyapp.com

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
